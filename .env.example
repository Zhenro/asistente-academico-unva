# ==========================================
# UNVA Asistente Virtual - Variables de Entorno
# ==========================================

# Proveedor de Modelo: 'gemini', 'openai' u 'offline'
MODEL_PROVIDER=gemini

# Google Gemini API Key (Recomendado - Gratuito para prototipos en aistudio.google.com)
GEMINI_API_KEY=

# Modelo Gemini (ej. gemini-3.1-flash-lite, gemini-3.5-flash-lite, gemini-flash-lite-latest)
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI API Key (Opcional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Telegram Bot Token (Opcional - Obtener gratis en Telegram con @BotFather)
TELEGRAM_BOT_TOKEN=

# Contraseña del Panel Administrativo de Secretaría (/admin)
ADMIN_PASSWORD=unva2026

# Configuración RAG
CHUNK_SIZE=600
CHUNK_OVERLAP=100
TOP_K_RESULTS=4
